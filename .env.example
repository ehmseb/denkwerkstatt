# Vorlage für die Umgebungsvariablen. Auf Railway unter «Variables» eintragen,
# lokal als Datei .env (wird nicht eingecheckt) oder direkt in der Shell setzen.

# Zugangspasswort für die KI-Anfragen. Unbedingt setzen, sonst kann jede Person mit der Adresse auf deine Kosten Anfragen stellen.
APP_PASSWORD=

# Vorgabe: welcher Anbieter und welche Modelle
LLM_PROVIDER=mistral
LLM_MODEL=mistral-medium-latest
LLM_FAST_MODEL=mistral-small-latest

# Schlüssel: nur die Anbieter eintragen, die du nutzen willst
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
INFOMANIAK_API_KEY=
INFOMANIAK_PRODUCT_ID=
# Eigener OpenAI-kompatibler Server, z. B. eine Ollama-Instanz
COMPAT_BASE_URL=
COMPAT_API_KEY=

# 1 = im Browser darf zwischen den eingerichteten Anbietern und Modellen gewählt werden
ALLOW_MODEL_CHOICE=0

# Nur nötig, wenn die Seite woanders liegt (z. B. GitHub Pages) und diesen Server nutzt.
# Kommagetrennt, ohne Schrägstrich am Ende, z. B. https://ehmseb.github.io
ALLOWED_ORIGINS=

# Schutz vor Missbrauch und Kosten
RATE_LIMIT_PER_MIN=20
MAX_OUTPUT_TOKENS=4000
MAX_INPUT_CHARS=120000
